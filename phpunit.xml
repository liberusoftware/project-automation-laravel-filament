<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>modules/*/tests</directory>
            <exclude>modules/activity-comments/tests</exclude>
            <exclude>modules/api-access/tests</exclude>
            <exclude>modules/currency-context/tests</exclude>
            <exclude>modules/feature-flags/tests</exclude>
            <exclude>modules/identity-core-filament/tests</exclude>
            <exclude>modules/identity-socialstream/tests</exclude>
            <exclude>modules/integrations/tests</exclude>
            <exclude>modules/localization-core/tests</exclude>
            <exclude>modules/localization-core-livewire/tests</exclude>
            <exclude>modules/module-manager-filament/tests</exclude>
            <exclude>modules/observability/tests</exclude>
            <exclude>modules/organizations-teams/tests</exclude>
            <exclude>modules/organizations-teams-filament/tests</exclude>
            <exclude>modules/roles-permissions/tests</exclude>
            <exclude>modules/scheduler-queues/tests</exclude>
            <exclude>modules/search/tests</exclude>
            <exclude>modules/settings-filament/tests</exclude>
            <exclude>modules/theme-support/tests</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules/*/src</directory>
        </include>
        <exclude>
            <directory>modules/*/src/Legacy</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:3xVFJ5tTr05dWL1gsJqF+UvWdv3X0Cz/CBaUG47hb3U="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
